# Cloudflare Pages local development secrets. Copy to .dev.vars and fill locally.
# Never commit .dev.vars or expose any of these as VITE_* variables.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH is not supported by Pages Functions; paste the PEM secret above.
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_REPOSITORY_ID=
SESSION_SECRET=

PRICE_CACHE_TTL=3600
PRICE_LOOKUP_TIMEOUT_MS=3000
MAX_VENDOR_REQUESTS=10
SEARCH_INDEX_BATCH_SIZE=500

PARTSOUQ_API_KEY=
AMAYAMA_API_KEY=
SUBARU_PARTS_API_KEY=
TOYOTA_PARTS_DEAL_API_KEY=
NAPA_API_KEY=
OREILLY_API_KEY=
AUTOZONE_API_KEY=
PARTSGEEK_API_KEY=
EBAY_APP_ID=
AMAZON_ASSOCIATE_TAG=
