{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "motornote-manual-retrieval",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "ai": {
    "binding": "AI"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
